{
  "info": {
    "_postman_id": "ba52b687-6829-4bdd-9a0d-4b3872c67b15",
    "name": "Clinic Quiz 2",
    "description": "Postman requests for requirements A1-A4, B1-B4, and C1-C4.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:1014" },
    { "key": "patientId", "value": "1" },
    { "key": "doctorId", "value": "1" }
  ],
  "item": [
    {
      "name": "A1",
      "request": {
        "method": "GET",
        "header": [],
        "description": "Find patients by last name.",
        "url": {
          "raw": "{{baseUrl}}/api/patients/by-last-name?lastName=Uwase",
          "host": ["{{baseUrl}}"],
          "path": ["api", "patients", "by-last-name"],
          "query": [{ "key": "lastName", "value": "Uwase" }]
        }
      }
    },
    {
      "name": "A2",
      "request": {
        "method": "GET",
        "header": [],
        "description": "Find appointments by status.",
        "url": {
          "raw": "{{baseUrl}}/api/appointments/by-status?status=SCHEDULED",
          "host": ["{{baseUrl}}"],
          "path": ["api", "appointments", "by-status"],
          "query": [{ "key": "status", "value": "SCHEDULED" }]
        }
      }
    },
    {
      "name": "A3",
      "request": {
        "method": "GET",
        "header": [],
        "description": "Find appointments in the inclusive date range.",
        "url": {
          "raw": "{{baseUrl}}/api/appointments/between?start=2026-10-01&end=2026-10-31",
          "host": ["{{baseUrl}}"],
          "path": ["api", "appointments", "between"],
          "query": [
            { "key": "start", "value": "2026-10-01" },
            { "key": "end", "value": "2026-10-31" }
          ]
        }
      }
    },
    {
      "name": "A4",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "description": "Create an appointment; a duplicate doctor/date should return 409.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"appointmentDate\": \"2026-10-20\",\n  \"reason\": \"Double-booking check\",\n  \"status\": \"SCHEDULED\",\n  \"patient\": { \"id\": {{patientId}} },\n  \"doctor\": { \"id\": {{doctorId}} }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/appointments/save",
          "host": ["{{baseUrl}}"],
          "path": ["api", "appointments", "save"]
        }
      }
    },
    {
      "name": "B1",
      "request": {
        "method": "GET",
        "header": [],
        "description": "Find doctors by specialization.",
        "url": {
          "raw": "{{baseUrl}}/api/doctors/by-specialization?name=Cardiology",
          "host": ["{{baseUrl}}"],
          "path": ["api", "doctors", "by-specialization"],
          "query": [{ "key": "name", "value": "Cardiology" }]
        }
      }
    },
    {
      "name": "B2",
      "request": {
        "method": "GET",
        "header": [],
        "description": "Find doctors without an office.",
        "url": {
          "raw": "{{baseUrl}}/api/doctors/without-office",
          "host": ["{{baseUrl}}"],
          "path": ["api", "doctors", "without-office"]
        }
      }
    },
    {
      "name": "B3",
      "request": {
        "method": "GET",
        "header": [],
        "description": "Find specializations that no doctor offers.",
        "url": {
          "raw": "{{baseUrl}}/api/specializations/unused",
          "host": ["{{baseUrl}}"],
          "path": ["api", "specializations", "unused"]
        }
      }
    },
    {
      "name": "B4",
      "request": {
        "method": "GET",
        "header": [],
        "description": "Find the patients of a doctor.",
        "url": {
          "raw": "{{baseUrl}}/api/patients/of-doctor/{{doctorId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "patients", "of-doctor", "{{doctorId}}"]
        }
      }
    },
    {
      "name": "C1",
      "request": {
        "method": "GET",
        "header": [],
        "description": "Count appointments grouped by status.",
        "url": {
          "raw": "{{baseUrl}}/api/appointments/stats/by-status",
          "host": ["{{baseUrl}}"],
          "path": ["api", "appointments", "stats", "by-status"]
        }
      }
    },
    {
      "name": "C2",
      "request": {
        "method": "GET",
        "header": [],
        "description": "Find patients with at least the specified number of appointments.",
        "url": {
          "raw": "{{baseUrl}}/api/patients/frequent?min=3",
          "host": ["{{baseUrl}}"],
          "path": ["api", "patients", "frequent"],
          "query": [{ "key": "min", "value": "3" }]
        }
      }
    },
    {
      "name": "C3",
      "request": {
        "method": "GET",
        "header": [],
        "description": "Find the busiest office.",
        "url": {
          "raw": "{{baseUrl}}/api/offices/busiest",
          "host": ["{{baseUrl}}"],
          "path": ["api", "offices", "busiest"]
        }
      }
    },
    {
      "name": "C4",
      "request": {
        "method": "PATCH",
        "header": [],
        "description": "Cancel non-completed appointments for a doctor on the specified date.",
        "url": {
          "raw": "{{baseUrl}}/api/appointments/cancel-day?doctorId={{doctorId}}&date=2026-10-20",
          "host": ["{{baseUrl}}"],
          "path": ["api", "appointments", "cancel-day"],
          "query": [
            { "key": "doctorId", "value": "{{doctorId}}" },
            { "key": "date", "value": "2026-10-20" }
          ]
        }
      }
    }
  ]
}
